{
  "$comment": "Who owns which path in an ATLAS workspace. `swe-atlas update` writes only paths the new template ships (template, seeded, additive) plus the record; everything else is yours and is never written. Patterns: * = one path segment, ** = any depth.",
  "record": ".atlas/installed.json",
  "template": [
    ".claude/atlas-manifest.json",
    ".claude/agents/**",
    ".claude/commands/**",
    ".claude/hooks/**",
    ".claude/reference/**",
    ".claude/rules/workspace.md",
    ".claude/scripts/**",
    ".claude/skills/**",
    ".claude/templates/**",
    "docs/external-information/*.md",
    "misc/archive/**"
  ],
  "seeded": [
    "CLAUDE.md",
    "misc/self/**"
  ],
  "additive": [
    ".gitignore",
    ".gitattributes",
    ".claude/settings.json"
  ],
  "user": [
    "NOTES.md",
    "index.md",
    "PROJECT.md",
    "STATUS.md",
    "DEPLOY.md",
    "projects/**",
    "general/**",
    "repos/**",
    "gitignored/**",
    "**/.env",
    "**/.env.*",
    ".atlas/config.json",
    ".atlas/secrets/**",
    ".claude/settings.local.json",
    ".claude/worktrees/**",
    ".claude/rules/design/**",
    ".claude/rules/atlas-self-profile.md",
    ".claude/rules/*-conventions.md",
    ".mcp.json",
    ".playwright/**",
    "docs/decision_logs/**",
    "docs/knowledge/**",
    "docs/phases/**",
    "docs/plans/**",
    "docs/living-spec-docs/**",
    "docs/living-test-cases/**",
    "docs/learning-from-mistakes/**",
    "docs/deploys.md",
    "docs/brief.md",
    "docs/external-information/skills/**",
    "misc/prototypes/**",
    "misc/wireframes/**",
    "misc/test-runs/**",
    "misc/screenshots/**",
    "misc/design-explore/**",
    "misc/.playwright/**",
    "misc/browser-storage/**"
  ],
  "$removed": "Paths an earlier release shipped and this one does not. sha256 is the content ATLAS shipped there (line endings normalised): new-project removes a file only when it matches, so a file of yours at the same path stays.",
  "removed": [
    { "path": ".claude/hooks/task-complete.cjs", "since": "3.0.0", "sha256": ["ebd8f524d78ac534b5a876fd0791e10b2bcd54fa9ef106eec552f912b9da4cec"], "note": "replaced by notify.cjs" },
    { "path": ".claude/hooks/task-complete.wav", "since": "3.0.0", "sha256": ["f951abdae8175a5a9cf5840c1c32178860e0d051a49ffe8a37ff82bbe587c261"], "note": "replaced by notify.cjs" },
    { "path": ".claude/hooks/ask-user-input.cjs", "since": "3.0.0", "sha256": ["a8e761a22109a83fed5f4a8310a2d6e7ccfb0b4cede8c7d15108ec0eee018570"], "note": "replaced by notify.cjs" },
    { "path": ".claude/hooks/task-complete.js", "since": "3.0.0", "sha256": ["ebd8f524d78ac534b5a876fd0791e10b2bcd54fa9ef106eec552f912b9da4cec"], "note": "the 2.1 to 2.6.2 name of task-complete.cjs; replaced by notify.cjs" },
    { "path": ".claude/hooks/ask-user-input.js", "since": "3.0.0", "sha256": ["a8e761a22109a83fed5f4a8310a2d6e7ccfb0b4cede8c7d15108ec0eee018570"], "note": "the 2.1 to 2.6.2 name of ask-user-input.cjs; replaced by notify.cjs" },
    { "path": ".claude/agents/code-explorer.md", "since": "3.0.0", "sha256": ["88f8774cb94946a197246847849160ee89034e9d4f4b2e4fdac8a7dd8812ce29"], "note": "built into Claude Code (Explore)" },
    { "path": ".claude/agents/code-architect.md", "since": "3.0.0", "sha256": ["4e6781f320c98ef1d2b1038a7a1ea38b17ebb4ae15e3eb22a438b1870440302b"], "note": "built into Claude Code (Plan)" },
    { "path": ".claude/agents/code-review.md", "since": "3.0.0", "sha256": ["87b43b872d0776ed5b5cf3a5c450814dd1c39037feb2e083a2f9638f46abff30"], "note": "built into Claude Code (/code-review)" },
    { "path": ".claude/agents/code-simplifier.md", "since": "3.0.0", "sha256": ["187b1b8ce0f6e7389d09dd52fc82abb4a55e39648957000cba60fe646aab742d"], "note": "built into Claude Code (/simplify)" },
    { "path": ".claude/agents/qa-manual-tester.md", "since": "3.0.0", "sha256": ["36fc8b807d40545ff9ade09d85e175edf306fdc131c42533956363cd6b2959e0"], "note": "replaced by manual-qa-haiku and manual-qa-sonnet" },
    { "path": ".claude/commands/plandev", "since": "3.0.0", "sha256": ["652e5d6264fd253fcb70c2f84de986a88d77109a02410aacd90230a6ab4bf557"], "note": "its agents are built into Claude Code" }
  ],
  "$moves": "Paths this version looks for somewhere else. update reports them and never moves anything. A sha256 on an entry is the unfilled template an older release shipped at `from`: new-project removes that file only when it matches.",
  "moves": [
    { "from": ".claude/rules/PROJECT.md", "to": "PROJECT.md (multi mode: projects/<name>/CLAUDE.md)", "since": "3.0.0", "note": "the project map left .claude/rules/; fold it in with /atlas:get-to-know" },
    { "from": ".claude/rules/DESIGN.md", "to": ".claude/rules/design/<name>.md", "since": "3.0.0", "sha256": ["39c303b50b81131ab2318bdaf20e3ebd0721b93eda6a258dae087f9f68c41e08"], "note": "design rules are path-scoped now; convert with /design:create-design-md or /atlas:mode" }
  ]
}
